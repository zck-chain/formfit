# ===== FormFit 环境变量 =====
# 复制本文件为 .env 并填入真实值；.env 不要提交到 git

# ---- 运行环境 ----
# development：允许本地占位配置，cookie 不强制 secure，CORS 可回退 *
# production：启用安全门禁（占位密钥拒绝启动）、cookie secure、CORS 必须显式白名单
ENVIRONMENT=development

# ---- DeepSeek（文本对话 / 计划编排）----
# 申请地址：https://platform.deepseek.com/
DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ---- 阿里云通义千问 Qwen-VL（看图 / 视频定性评估）----
# 申请地址：https://dashscope.console.aliyun.com/
DASHSCOPE_API_KEY=sk-your-dashscope-key
DASHSCOPE_VL_MODEL=qwen-vl-max-latest

# ---- 安全 ----
# 生产环境务必改成随机长字符串：openssl rand -hex 32
# JWT_SECRET 用于 App 端登录令牌；ADMIN_SESSION_SECRET 必须是另一个独立随机串
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_SESSION_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ---- CORS ----
# 逗号分隔的允许来源。生产必须显式列出，且不得填 *（与 credentials 冲突且不安全）。
# 开发留空则回退 * 并自动关闭 credentials。
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ---- 管理员（Web 后台首次登录）----
# 生产环境不得使用 change-me-admin，且长度至少 12 位
ADMIN_EMAIL=admin@formfit.local
ADMIN_PASSWORD=change-me-admin

# ---- 数据库 ----
# 默认 SQLite，文件位于项目根目录 formfit.db
DATABASE_URL=sqlite:///./formfit.db

# ---- 上传约束（体态评估图片）----
# 单次上传最大字节数（默认 10485760 = 10MiB）；允许的 MIME 类型
UPLOAD_MAX_BYTES=10485760
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/webp

# ---- 服务 ----
APP_HOST=127.0.0.1
APP_PORT=8000
