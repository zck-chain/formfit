# ===== FormFit 环境变量 =====
# 复制本文件为 .env 并填入真实值；.env 不要提交到 git

# ---- 运行环境 ----
# development=开发（默认密钥仅 warning）；production=生产（默认密钥直接拒绝启动）
APP_ENV=development

# ---- DeepSeek（文本对话 / 计划编排）----
# 申请地址：https://platform.deepseek.com/
DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ---- 阿里云通义千问 Qwen-VL（看图 / 视频定性评估）----
# 申请地址：https://dashscope.console.aliyun.com/
DASHSCOPE_API_KEY=sk-your-dashscope-key
DASHSCOPE_VL_MODEL=qwen-vl-max-latest

# ---- 安全 ----
# 生产环境务必改成随机长字符串：openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# 后台 session 独立签名密钥（必须与 JWT_SECRET 不同），生产必填：
# openssl rand -hex 32
ADMIN_SESSION_SECRET=
# 后台登录 cookie 有效期（秒），默认 7 天
ADMIN_SESSION_MAX_AGE_SECONDS=604800

# ---- CORS ----
# 允许的跨域来源，逗号分隔（如 https://app.formfit.com,https://admin.formfit.com）。
# 留空：开发放开 localhost 常用端口；生产仅允许同源（不使用 "*"）。
CORS_ORIGINS=

# ---- 上传 ----
# 单张图片最大字节数，默认 10MB
UPLOAD_MAX_BYTES=10485760

# ---- 限流（应用层兜底；格式 N/period，period=second|minute|hour|day）----
# 是否部署在可信反向代理（Nginx/APISIX/云 WAF/负载均衡）之后。
# - false（默认，直连）：用 TCP 直连地址计数，忽略客户端传入的 X-Forwarded-For，
#   防止攻击者伪造/轮换 XFF 绕过注册、登录的暴力破解限流。
# - true：采信 X-Forwarded-For 首个 IP。仅当能保证代理会覆写/清洗该头时才开启，
#   否则等于把限流 key 的控制权交给客户端。
TRUSTED_PROXY_ENABLED=false
RATE_LIMIT_REGISTER=10/minute
RATE_LIMIT_LOGIN=20/minute
RATE_LIMIT_ASSESS=30/minute
RATE_LIMIT_GENERATE_PLAN=20/minute
RATE_LIMIT_CREATE_ORDER=30/minute

# ---- 免费档月度配额 ----
# 免费用户每个 PRO 功能（体态评估 / AI 计划生成）每月可用次数，按自然月 UTC。
# 0 = 免费档完全无额度；PRO 用户不受限。
FREE_QUOTA_PER_MONTH=5

# ---- 管理员（Web 后台首次登录）----
# 生产环境必须改成强密码（≥8 位），否则启动失败
ADMIN_EMAIL=admin@formfit.local
ADMIN_PASSWORD=change-me-admin

# ---- 数据库 ----
# 默认 SQLite，文件位于项目根目录 formfit.db
DATABASE_URL=sqlite:///./formfit.db

# ---- 服务 ----
APP_HOST=127.0.0.1
APP_PORT=8000

# ---- 支付 ----
# 启用的支付渠道，逗号分隔。本地联调用 sandbox；可同时启用 alipay / wechat。
# 可选：sandbox / apple / alipay / wechat
PAYMENT_CHANNELS=sandbox
# 回调地址对外可访问的基地址（沙箱支付链接拼接用）
PAYMENT_CALLBACK_BASE_URL=http://127.0.0.1:8000
# 沙箱渠道签名密钥（仅本地/联调，生产不要用默认值）
SANDBOX_SECRET=sandbox-dev-secret

# Apple App Store 内购（若首发 iOS）
APPLE_SHARED_SECRET=
APPLE_BUNDLE_ID=
# true=生产端点，false=沙箱端点（TestFlight 会自动回退）
APPLE_PRODUCTION=false

# 支付宝（手机网站/App 支付，RSA2）
# APP_ID 在开放平台获取；PRIVATE_KEY 为商户应用私钥（PEM）；
# PUBLIC_KEY 为支付宝公钥（PEM，用于验签回调，不是商户公钥）。
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_CALLBACK_URL=

# 微信支付（JSAPI/APP 支付，APIv3）
# API_V3_KEY 为 32 字节 APIV3 密钥，用于回调解密；PLATFORM_CERT 为微信支付平台证书（PEM）；
# MCH_PRIVATE_KEY 为商户 API 私钥（apiclient_key.pem）；MCH_SERIAL_NO 为商户证书序列号。
WECHAT_APP_ID=
WECHAT_MCH_ID=
WECHAT_API_V3_KEY=
WECHAT_PLATFORM_CERT=
WECHAT_MCH_PRIVATE_KEY=
WECHAT_MCH_SERIAL_NO=
WECHAT_NOTIFY_URL=
